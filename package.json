    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "wrangler": "^4.151.2"
  },
  "engines": {
    "node": ">=22.6"
  }
}
